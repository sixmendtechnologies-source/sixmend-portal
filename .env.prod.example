# Copy this to .env.prod and fill in the values before deploying
# NEVER commit .env.prod to git

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=sixportal
POSTGRES_USER=sixportal
POSTGRES_PASSWORD=change_me_use_a_strong_password

# ─── Backend ─────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_use_a_64_char_random_string
PORT=9000
NODE_ENV=production
ENQUIRY_API_KEY=smx_vtA5Fx3rJXLjzYS2e8mTG01yHaPDsCWU

# ─── Portal URL (used in activation email links) ──────────────────────────────
PORTAL_URL=https://manage.sixmend.com

# ─── SMTP (Gmail) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password

# ─── Docker image references ──────────────────────────────────────────────────
# Pattern: 555292118815.dkr.ecr.ap-south-1.amazonaws.com/<repo>:<service>-v<version>
BACKEND_IMAGE=555292118815.dkr.ecr.ap-south-1.amazonaws.com/backend:sixportal-api-v1.0.0
FRONTEND_IMAGE=555292118815.dkr.ecr.ap-south-1.amazonaws.com/frontend:sixportal-web-v1.0.0
