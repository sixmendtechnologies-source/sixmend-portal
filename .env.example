# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=sixportal
POSTGRES_USER=sixportal
POSTGRES_PASSWORD=sixportal_secret

# ─── Backend ─────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_in_production
PORT=4000
NODE_ENV=development
ENQUIRY_API_KEY=your_api_key_here

# ─── Portal URL (used in activation email links) ──────────────────────────────
PORTAL_URL=http://localhost:4758

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000

# ─── SMTP (Gmail) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
